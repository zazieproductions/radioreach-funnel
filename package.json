{
  "name": "radioreach-funnel",
  "private": true,
  "version": "0.0.0",
  "description": "Conversion-focused, edge-native storefront for RadioReach with adaptive React UX, Stripe Embedded Checkout, verified webhooks, Cloudflare KV, and private R2 fulfillment.",
  "homepage": "https://radioreach.us",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-resources.mjs && vite build",
    "build:resources": "node scripts/build-resources.mjs",
    "build:fd": "tsx scripts/build-frequency-dominion-zip.ts",
    "preview": "vite preview",
    "test:esp": "node scripts/run-esp-tests.mjs",
    "test:lab": "node scripts/run-lab-tests.mjs",
    "test:slots": "node scripts/run-slots-tests.mjs",
    "lint": "tsc --noEmit",
    "test:checkout": "node --experimental-test-module-mocks --import tsx --test scripts/test-checkout.ts scripts/test-checkout-ui.ts",
    "test:course": "node --import tsx --test scripts/test-course.ts",
    "test": "npm run test:esp && npm run test:lab && npm run test:checkout && npm run test:course"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.13.0",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "^22.4.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
