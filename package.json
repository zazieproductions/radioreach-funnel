{
  "name": "radioreach-funnel",
  "private": true,
  "version": "0.0.0",
  "description": "Conversion-focused, edge-native storefront for RadioReach with adaptive React UX, Stripe Embedded Checkout, verified webhooks, Cloudflare KV, and private R2 fulfillment.",
  "homepage": "https://radioreach.us",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-resources.mjs && vite build && vite build --config signal-rot-mastering-suite/vite.config.ts",
    "build:resources": "node scripts/build-resources.mjs",
    "preview": "vite preview",
    "test:seo": "tsx --test scripts/test-structured-data.ts",
    "test:esp": "node scripts/run-esp-tests.mjs",
    "test:lab": "node scripts/run-lab-tests.mjs",
    "test:slots": "node scripts/run-slots-tests.mjs",
    "lint": "tsc --noEmit && tsc --noEmit -p signal-rot-mastering-suite/tsconfig.json",
    "test:checkout": "node --experimental-test-module-mocks --import tsx --test scripts/test-checkout.ts scripts/test-checkout-ui.ts",
    "test": "tsx --tsconfig signal-rot-mastering-suite/tsconfig.json --test signal-rot-mastering-suite/tests/*.test.ts signal-rot-mastering-suite/tests/*.test.tsx && npm run test:esp && npm run test:lab && npm run test:checkout && npm run test:seo",
    "test:dsp": "tsx --tsconfig signal-rot-mastering-suite/tsconfig.json signal-rot-mastering-suite/scripts/run-dsp-fixtures.ts",
    "dev:signal-rot": "vite --config signal-rot-mastering-suite/vite.config.ts",
    "test:immersive": "tsx --tsconfig signal-rot-mastering-suite/tsconfig.json --test signal-rot-mastering-suite/tests/immersive.test.ts",
    "test:e2e": "tsx --tsconfig signal-rot-mastering-suite/tsconfig.json --test signal-rot-mastering-suite/tests/e2e.integration.ts",
    "freeze:presets": "tsx --tsconfig signal-rot-mastering-suite/tsconfig.json signal-rot-mastering-suite/scripts/freeze-presets.ts signal-rot-mastering-suite/baselines/listening-bank-20.7.json",
    "test:browser": "npm --prefix signal-rot-mastering-suite run test:browser"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.13.0",
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "^22.4.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0"
  }
}
