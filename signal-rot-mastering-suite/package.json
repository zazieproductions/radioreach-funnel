{
  "name": "signal-rot-mastering-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --tsconfig tsconfig.json --test tests/*.test.ts tests/*.test.tsx",
    "test:dsp": "tsx --tsconfig tsconfig.json scripts/run-dsp-fixtures.ts",
    "build": "vite build --config vite.config.ts",
    "test:immersive": "tsx --tsconfig tsconfig.json --test tests/immersive.test.ts",
    "test:e2e": "tsx --tsconfig tsconfig.json --test tests/e2e.integration.ts",
    "freeze:presets": "tsx --tsconfig tsconfig.json scripts/freeze-presets.ts baselines/listening-bank-20.7.json",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "5.1.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
