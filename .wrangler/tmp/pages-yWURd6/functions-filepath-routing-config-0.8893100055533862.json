{
  "routes": [
    {
      "routePath": "/api/checkout/session",
      "mountPath": "/api/checkout",
      "method": "POST",
      "module": [
        "api/checkout/session.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/checkout/verify",
      "mountPath": "/api/checkout",
      "method": "GET",
      "module": [
        "api/checkout/verify.ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/downloads/session",
      "mountPath": "/api/downloads",
      "method": "POST",
      "module": [
        "api/downloads/session.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/stripe/webhook",
      "mountPath": "/api/stripe",
      "method": "POST",
      "module": [
        "api/stripe/webhook.ts:onRequestPost"
      ]
    }
  ],
  "baseURL": "/"
}