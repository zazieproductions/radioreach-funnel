/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  # strict-origin-when-cross-origin (not no-referrer) so referral traffic is
  # still attributable in analytics while full URLs stay private cross-origin.
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

# Static HTML content pages — short cache, revalidated so edits go live fast
/resources/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/privacy-policy/*
  Cache-Control: public, max-age=3600

/terms/*
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

# Never index API responses
/api/*
  X-Robots-Tag: noindex, nofollow
